<?xml version="1.0" encoding="utf-8"?>
<!-- 005: GitHub Packages feed'i (Platform.Auth) SÖKÜLDÜ — auth kablosu Common/Auths'a katlandı,
     kimlik makamı çözüm içinde (src/others/Identity.Server; ADR adr-identity-inward).
     GH_PACKAGES_TOKEN gereksinimi bitti; restore yalnız nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
