<?xml version="1.0" encoding="utf-8"?>
<!-- Platform.Auth paylaşılan paketi GitHub Packages (NuGet) feed'inden (AgentPlatform üretir + yayınlar).
     Namespace'ler Common.* olduğundan tüketici servislerde using değişmez.
     Yerel dosya feed'i (local-nuget) söküldü: sibling disk yolu CI runner'da YOK → NU1301. Uzak feed
     (nuget.pkg.github.com) her makineden erişilir. Auth env var ile: token dosyaya GÖMÜLMEZ.
       - Yerel restore:  export GH_PACKAGES_TOKEN=<PAT read:packages>
       - CI restore:     GH_PACKAGES_TOKEN = GITHUB_TOKEN (ci.yml env) -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="github" value="https://nuget.pkg.github.com/hasancagri/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github>
      <add key="Username" value="hasancagri" />
      <add key="ClearTextPassword" value="%GH_PACKAGES_TOKEN%" />
    </github>
  </packageSourceCredentials>
</configuration>