<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>

        <PackageReference Include="Azure.Storage.Blobs" />
        <PackageReference Include="MassTransit.RabbitMQ" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="Microsoft.AspNetCore.Http" />
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Abstractions" />
        <PackageReference Include="Microsoft.Data.SqlClient" />
        <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
        <PackageReference Include="Microsoft.Extensions.Http" />
        <PackageReference Include="PagedList.Core" />
        <PackageReference Include="Scrutor" />
        <PackageReference Include="StackExchange.Redis" />
        <PackageReference Include="WolverineFx" />
        <!-- 088: ölü-mesaj operatör tool'u ([McpServerTool]) Common'da (çapraz-kesen infra). -->
        <PackageReference Include="ModelContextProtocol.Core" />
        <!-- 084: nötr auth kablosu (IdentityOption + AddAuthenticationAndAuthorizationExtension) buradan
             ayrıldı → Platform.Auth paketi. Namespace artık Platform.Auth (eski Common.* bırakıldı);
             tüketiciler `using Platform.Auth` kullanır (AgentPlatform Mcp.Gateway ile hizalı). -->
        <PackageReference Include="Platform.Auth" />
    </ItemGroup>
    <ItemGroup>
        <!-- İŞARET (088, GÖZDEN GEÇİR): Common→Shared bağı — portable-infra katmanı proje sözleşmesine
             bağlanıyor (DLQ tool'u Shared.McpToolNames/Descriptions okur). Bilinçli/pragmatik: Shared yaprak
             (cycle yok) + Common zaten proje sözlüğü taşıyor (AuthorizationScopes). İleride tool'u Shared'a
             taşıyıp Common'ı saf tutma seçeneği tartışılacak. memory: common-shared-coupling-revisit. -->
        <ProjectReference Include="..\Shared\Shared.csproj" />
    </ItemGroup>
</Project>
