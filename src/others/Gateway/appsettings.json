{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "catalog-admin": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/admin/catalog/{**catch-all}" }
      },
      "catalog": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/{**catch-all}" }
      },
      "files": {
        "ClusterId": "file",
        "Match": { "Path": "/files/{**catch-all}" }
      },
      "personalization": {
        "ClusterId": "personalization",
        "Match": { "Path": "/api/personalization/{**catch-all}" }
      },
      "chat": {
        "ClusterId": "scout",
        "Match": { "Path": "/api/chat/{**catch-all}" }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "catalog": { "Address": "http://catalog-api" }
        }
      },
      "file": {
        "Destinations": {
          "file": { "Address": "http://file-api" }
        }
      },
      "personalization": {
        "Destinations": {
          "personalization": { "Address": "http://personalization-api" }
        }
      },
      "scout": {
        "Destinations": {
          "scout": { "Address": "http://scout-agent" }
        }
      }
    }
  }
}
