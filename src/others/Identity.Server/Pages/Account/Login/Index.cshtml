@page
@model Identity.Server.Pages.Login.Index

<div class="login-page">
    <div class="lead">
        <h1>Login</h1>
        <p>Choose how to login</p>
        @* Giris zorunlu degil: kullanici istedigi an giris yapmadan Dashboard'a donebilir. *@
        <a href="https://localhost:7042/" class="btn btn-link">Giriş yapmadan devam et</a>
    </div>

    <partial name="_ValidationSummary" />

    @if (TempData["ExternalLoginError"] is string externalLoginError)
    {
        <div class="alert alert-danger">@externalLoginError</div>
    }

    <div class="row">
        <div class="col-sm-6">
            <div class="card">
                <div class="card-header">
                    <h2>Local Account</h2>
                </div>

                <div class="card-body">
                    <form asp-page="/Account/Login/Index">
                        <input type="hidden" asp-for="Input.ReturnUrl" />

                        <div class="form-group">
                            <label asp-for="Input.Username"></label>
                            <input class="form-control" placeholder="Username" asp-for="Input.Username" autofocus>
                        </div>
                        <div class="form-group">
                            <label asp-for="Input.Password"></label>
                            <input type="password" class="form-control" placeholder="Password" asp-for="Input.Password" autocomplete="off">
                        </div>

                        @if (Model.AllowRememberLogin)
                        {
                            <div class="form-group">
                                <div class="form-check">
                                    <input class="form-check-input" asp-for="Input.RememberLogin">
                                    <label class="form-check-label" asp-for="Input.RememberLogin">
                                        Remember My Login
                                    </label>
                                </div>
                            </div>
                        }

                        <button class="btn btn-primary" name="Input.Button" value="login">Login</button>
                        <a class="btn btn-link" asp-page="/Account/ForgotPassword/Index">Şifremi unuttum</a>
                        <button class="btn btn-secondary" name="Input.Button" value="cancel">Cancel</button>
                    </form>

                    @if (Model.GoogleEnabled)
                    {
                        <hr />
                        <a class="btn btn-outline-dark w-100 d-inline-flex align-items-center justify-content-center gap-2"
                           asp-page="/Account/ExternalLogin/Index"
                           asp-route-returnUrl="@Model.Input.ReturnUrl">
                            <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
                                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                            </svg>
                            Google ile devam et
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="mt-3 text-center">
            <p>Hesabınız yok mu? <a asp-page="/Account/Create/Index" asp-route-returnUrl="@Model.Input.ReturnUrl" class="btn btn-outline-primary btn-sm">Kayıt Ol</a></p>
        </div>
    </div>
</div>