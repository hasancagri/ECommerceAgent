@page
@model Identity.Server.Pages.Error.Index

<div class="error-page">
    <div class="lead">
        <h1>Error</h1>
    </div>

    <div class="row">
        <div class="col-sm-6">
            <div class="alert alert-danger">
                Sorry, there was an error
                @if (Model.Error != null)
                {
                    <strong><em>: @Model.Error</em></strong>
                }
            </div>
        </div>
    </div>
</div>