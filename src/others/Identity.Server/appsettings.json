{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "OpenIddict": {
    "Issuer": "https://localhost:5001"
  },
  "AppRegistry": {
    "Apps": [
      {
        "AppId": "ecommerce",
        "ScopeNamespace": {
          "Prefix": "ecommerce",
          "Scopes": [
            {
              "Name": "catalog.read",
              "Audience": "catalog.api",
              "Description": "Katalog okuma (admin; taslak dahil)"
            },
            {
              "Name": "catalog.write",
              "Audience": "catalog.api",
              "Description": "Katalog yazma (ürün/marka/kategori)"
            },
            {
              "Name": "basket.read",
              "Audience": "basket.api",
              "Description": "Sepet okuma"
            },
            {
              "Name": "basket.write",
              "Audience": "basket.api",
              "Description": "Sepet yazma"
            },
            {
              "Name": "order.read",
              "Audience": "order.api",
              "Description": "Sipariş okuma"
            },
            {
              "Name": "order.write",
              "Audience": "order.api",
              "Description": "Sipariş yazma"
            },
            {
              "Name": "payment.read",
              "Audience": "payment.api",
              "Description": "Ödeme okuma"
            },
            {
              "Name": "payment.write",
              "Audience": "payment.api",
              "Description": "Ödeme yazma"
            },
            {
              "Name": "stock.write",
              "Audience": "stock.api",
              "Description": "Stok yazma (mutlak)"
            },
            {
              "Name": "customer.read",
              "Audience": "customer.api",
              "Description": "Müşteri (cüzdan/adres) okuma"
            },
            {
              "Name": "customer.write",
              "Audience": "customer.api",
              "Description": "Müşteri (cüzdan/adres) yazma"
            },
            {
              "Name": "reviews.write",
              "Audience": "reviews.api",
              "Description": "Ürün yorumu yazma"
            },
            {
              "Name": "library.read",
              "Audience": "library.api",
              "Description": "Kitaplık (fiyat alarmı) okuma"
            },
            {
              "Name": "library.write",
              "Audience": "library.api",
              "Description": "Kitaplık (fiyat alarmı) yazma"
            },
            {
              "Name": "discount.read",
              "Audience": "discount.api",
              "Description": "İndirim okuma (checkout S2S)"
            },
            {
              "Name": "discount.admin.write",
              "Audience": "discount.api",
              "Description": "Kampanya indirimi yönetimi (admin)"
            },
            {
              "Name": "ops.deadletter",
              "Audiences": [
                "catalog.api",
                "basket.api",
                "order.api",
                "payment.api",
                "stock.api",
                "customer.api",
                "reviews.api",
                "library.api",
                "discount.api"
              ],
              "Description": "Ölü-mesaj operatör yüzeyi (list/get/replay/discard; çapraz-kesen, tüm servisler)"
            }
          ]
        },
        "Clients": [
          {
            "ClientId": "react-web",
            "ClientSecret": null,
            "DisplayName": "EC React web (public, PKCE)",
            "IsPublic": true,
            "AllowAuthorizationCode": true,
            "AllowRefreshToken": true,
            "RedirectUris": [
              "http://localhost:5173/callback"
            ],
            "Scopes": [
              "openid",
              "profile",
              "email",
              "roles",
              "offline_access",
              "basket.read",
              "basket.write",
              "order.read",
              "order.write",
              "payment.read",
              "payment.write",
              "customer.read",
              "customer.write",
              "reviews.write",
              "library.read",
              "library.write",
              "catalog.read",
              "catalog.write",
              "stock.write",
              "discount.read",
              "discount.admin.write",
              "ops.deadletter",
              "identity.roles.manage"
            ]
          },
          {
            "ClientId": "order-saga",
            "ClientSecret": "order-saga-secret",
            "DisplayName": "Checkout saga (m2m)",
            "AllowClientCredentials": true,
            "Scopes": [
              "basket.write",
              "basket.read",
              "customer.read",
              "payment.write",
              "discount.read"
            ]
          },
          {
            "ClientId": "payment-s2s",
            "ClientSecret": "payment-s2s-secret",
            "DisplayName": "Payment S2S (m2m)",
            "AllowClientCredentials": true,
            "Scopes": [
              "customer.read"
            ]
          }
        ],
        "Roles": [
          {
            "Name": "customer",
            "Scopes": [
              "basket.read",
              "basket.write",
              "order.read",
              "order.write",
              "payment.read",
              "payment.write",
              "customer.read",
              "customer.write",
              "reviews.write",
              "library.read",
              "library.write"
            ]
          },
          {
            "Name": "admin",
            "Scopes": [
              "catalog.read",
              "catalog.write",
              "basket.read",
              "basket.write",
              "order.read",
              "order.write",
              "payment.read",
              "payment.write",
              "stock.write",
              "customer.read",
              "customer.write",
              "reviews.write",
              "library.read",
              "library.write",
              "discount.read",
              "discount.admin.write",
              "ops.deadletter",
              "identity.roles.manage"
            ]
          }
        ]
      }
    ]
  }
}
