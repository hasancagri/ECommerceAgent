{
  "ApiKeyAuth": {
    "InternalSecret": "dev-internal-secret"
  },
  "IdentityOption": {
    "Address": "https://localhost:5001",
    "Issuer": "https://localhost:5001",
    "Audience": "order.api"
  },
  "Checkout": {
    "WatchdogSeconds": 120
  },
  "SagaAuth": {
    "ClientId": "order-saga",
    "ClientSecret": "order-saga-secret"
  },
  "CheckoutReconcile": {
    "BackoffSeconds": [
      5,
      15,
      60,
      300
    ],
    "DeadlineSeconds": 3600
  },
  "CorrelationKeyOption": {
    "ServerSecret": "dev-correlation-key-secret-change-me"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
